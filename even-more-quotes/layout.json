   "x": 134,
   "y": 4384,
   "w": 560,
   "z": 1,
   "rot": 0,
   "type": "text",
   "text": {
    "text": "❦",
    "font": "Times New Roman",
    "size": 22,
    "bold": false,
    "italic": false,
    "align": "center",
    "color": "#8a7f5a",

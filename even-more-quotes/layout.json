  {
   "id": "b13",
   "x": 134,
   "y": 960,
   "w": 560,
   "z": 1,
   "rot": 0,
   "type": "text",
   "text": {
    "text": "“Or is it, that as in essence whiteness is not so much a colour as the visible absence of colour; and at the same time the concrete of all colours; is it for these reasons that there is such a dumb blankness, full of meaning, in a wide landscape of snows—a colourless, all-colour of atheism from which we shrink?”",
    "font": "Times New Roman",
    "size": 20,
    "bold": false,
    "italic": false,
    "align": "left",
    "color": "#000000",
    "outline": false,
    "bg": "none",
    "pad": 0,
    "source": ""
   }
  },

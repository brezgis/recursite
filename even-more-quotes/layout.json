   "x": 134,
   "y": 3848,
   "w": 560,
   "z": 1,
   "rot": 0,
   "type": "text",
   "text": {
    "text": "“Computer science is no more about computers than astronomy is about telescopes, biology is about microscopes or chemistry is about beakers and test tubes.”",
    "font": "Times New Roman",
    "size": 20,
    "bold": false,
    "italic": false,
    "align": "left",
    "color": "#000000",
    "outline": false,
    "bg": "none",
    "pad": 0,
    "source": ""
   }
  },
  {
   "id": "b47",
   "x": 134,
   "y": 3942,
   "w": 560,
   "z": 1,
   "rot": 0,
   "type": "text",
   "text": {
    "text": "— [Michael R. Fellows & Ian Parberry, *Computing Research News* (1993)](https://web.archive.org/web/2015/http://archive.cra.org/CRN/issues/9301.pdf)",
    "font": "Times New Roman",
    "size": 15,
    "bold": false,
    "italic": false,
    "align": "right",
    "color": "#4a4a3a",
    "outline": false,

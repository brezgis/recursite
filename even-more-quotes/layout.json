   "x": 134,
   "y": 4848,
   "w": 560,
   "z": 1,
   "rot": 0,
   "type": "text",
   "text": {
    "text": "“It turns out that an eerie type of chaos can lurk just behind a facade of order—and yet, deep inside the chaos lurks an even eerier type of order.”",
    "font": "Times New Roman",
    "size": 20,
    "bold": false,
    "italic": false,
    "align": "left",
    "color": "#000000",
    "outline": false,
